# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/markaz"

# Long random string (32+ chars). Generate: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Public URL of the site (used in QR codes and Paystack callback)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Paystack secret key (sk_test_... or sk_live_...). Leave empty to use demo mode.
PAYSTACK_SECRET_KEY=""
# When true AND no Paystack key is set, payments succeed instantly (for local testing only)
PAYMENTS_DEMO_MODE="true"

# First admin account (created by `npm run db:seed`)
ADMIN_EMAIL="admin@markazuligathah.org"
ADMIN_PASSWORD="ChangeMe!2026"

# Demo accounts: seeds 4 demo logins and shows them on /login. Set to "false" before launch.
DEMO_MODE="true"
